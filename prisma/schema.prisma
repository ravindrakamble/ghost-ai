generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Starter models — replace with your own
model Author {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  posts     Post[]
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  createdAt DateTime @default(now())
  authorId  String
  author    Author   @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([authorId])
}

enum ProjectStatus {
  DRAFT
  ARCHIVED
}

model Project {
  id               String                @id @default(cuid())
  ownerId          String
  name             String
  description      String?
  status           ProjectStatus         @default(DRAFT)
  canvasJsonPath   String?
  /// Public, unauthenticated read-only share token (spec 34). `null` means
  /// no active public link. `@unique` so `app/api/public/[token]/route.ts`
  /// can resolve a project with a single `findUnique`. Owner-only to
  /// generate/regenerate (overwrite) or revoke (set back to `null`) — see
  /// `app/api/projects/[projectId]/public-link/route.ts`.
  publicShareToken String?               @unique
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  collaborators    ProjectCollaborator[]
  taskRuns         TaskRun[]
  specs            ProjectSpec[]

  @@index([ownerId])
  @@index([createdAt])
}

model ProjectCollaborator {
  id        String   @id @default(cuid())
  projectId String
  email     String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([email])
  @@index([projectId, createdAt])
}

/// Tracks Trigger.dev background task runs (spec 22's design-agent task, plus
/// future task types) so ownership can be verified before a run-scoped public
/// token is issued (`app/api/ai/design/token/route.ts`).
model TaskRun {
  id        String   @id @default(cuid())
  runId     String   @unique
  projectId String
  userId    String
  createdAt DateTime @default(now())
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([userId, projectId])
}

/// Metadata for a generated technical spec (spec 27's `generate-spec` task
/// output, persisted by spec 28). The Markdown content itself lives in Vercel
/// Blob at `specs/{projectId}/{specId}.md` (`lib/spec-blob.ts`) — this model
/// holds only the reference, never the content
/// (`code-standards.md`: "Do not store large generated content directly in
/// the database"). No `userId` field: access is derived from the project
/// relationship via `getProjectAccess`, not per-spec ownership. No unique
/// constraint on `projectId` — multiple independently-downloadable specs per
/// project are expected, one per generation run, never overwritten (spec 28's
/// Analyst Brief, Open Questions #5).
model ProjectSpec {
  id          String   @id @default(cuid())
  projectId   String
  filePath    String
  /// Blob reference to the generated Terraform skeleton (spec 35), at
  /// `specs/{projectId}/{specId}.tf` (`lib/spec-blob.ts#iacBlobPathname`).
  /// Nullable — unlike `filePath`, which every row has always had — because
  /// every `ProjectSpec` row created before this field shipped has no
  /// Terraform content and never will; there is no real content to backfill,
  /// so a required column with a placeholder default would misrepresent "no
  /// IaC was ever generated" as "an empty but valid IaC file exists" (spec
  /// 35's Analyst Brief). `null` means no Terraform skeleton was ever
  /// generated for this spec.
  iacFilePath String?
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

/// A user's own saved canvas template (spec 33), lifting spec 18's "no
/// template saving" scope limit. Deliberately has no `projectId`/`Project`
/// relation — a saved template belongs to the *user*, reusable across any of
/// their projects, not scoped to the project it was saved from (spec 33's
/// Analyst Brief, Concrete deliverables). `ownerId` is a plain Clerk user ID
/// string (the same convention `Project.ownerId` already uses), not a
/// foreign key — this app has no local `User` table to reference. The
/// node/edge JSON itself lives in Vercel Blob at
/// `templates/{ownerId}/{templateId}.json` (`lib/template-blob.ts`) — this
/// model holds only the reference (`filePath`), never the content, per
/// `code-standards.md`'s "Do not store large generated content directly in
/// the database." `@@index([ownerId, createdAt])` mirrors `ProjectSpec`'s own
/// `@@index([projectId, createdAt])` — the same "list rows scoped to X,
/// sorted by createdAt" query shape `GET /api/templates` uses (spec 33's
/// Analyst Brief, Open Questions #1).
model CustomTemplate {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  description String?
  filePath    String
  createdAt   DateTime @default(now())

  @@index([ownerId, createdAt])
}
